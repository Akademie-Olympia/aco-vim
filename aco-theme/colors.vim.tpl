" Generated by aco-theme from ~/.config/vim/aco-theme/colors.vim.tpl. Do not edit.
set background={{mode}}
" Basis-Hintergrund & Text
highlight Normal       guifg={{text}} guibg={{bg}} ctermbg=NONE
highlight NonText      guifg={{border}} guibg={{bg}} ctermbg=NONE
highlight SpecialKey   guifg={{border}} guibg=NONE
highlight EndOfBuffer  guifg={{bg}} guibg={{bg}}
highlight CursorLine   guibg={{surface}} cterm=NONE
highlight ColorColumn  guibg={{surface_alt}}

" Zeilennummern & Sign-Spalte
highlight LineNr       guifg={{muted}} guibg={{bg}}
highlight CursorLineNr guifg={{accent}} guibg={{surface}} gui=bold cterm=bold
highlight SignColumn   guifg={{muted}} guibg={{bg}}

" Auswahl, Suche & Klammern
highlight Visual       guibg={{border}} gui=NONE
highlight Search       guifg={{bg}} guibg={{yellow}} gui=NONE
highlight IncSearch    guifg={{bg}} guibg={{orange}} gui=bold
highlight CurSearch    guifg={{bg}} guibg={{orange}} gui=bold
highlight MatchParen   guifg={{orange}} guibg={{border}} gui=bold

" Fensterrahmen & Popup-Menü
highlight VertSplit    guifg={{surface_alt}} guibg={{bg}} gui=NONE
highlight WinSeparator guifg={{surface_alt}} guibg={{bg}} gui=NONE
highlight Pmenu        guifg={{text}} guibg={{bg_alt}}
highlight PmenuSel     guifg={{on_accent}} guibg={{accent}} gui=bold
highlight PmenuSbar    guibg={{surface_alt}}
highlight PmenuThumb   guibg={{muted}}

" Syntax-Farben
highlight Comment      guifg={{muted}} gui=italic
highlight Constant     guifg={{orange}}
highlight String       guifg={{green}}
highlight Character    guifg={{cyan}}
highlight Number       guifg={{orange}}
highlight Boolean      guifg={{orange}}
highlight Identifier   guifg={{text}}
highlight Function     guifg={{accent}} gui=bold
highlight Statement    guifg={{purple}} gui=NONE
highlight Conditional  guifg={{purple}} gui=NONE
highlight Repeat       guifg={{purple}} gui=NONE
highlight Keyword      guifg={{purple}} gui=NONE
highlight Operator     guifg={{cyan}}
highlight PreProc      guifg={{pink}}
highlight Type         guifg={{yellow}} gui=NONE
highlight Special      guifg={{pink}}
highlight Error        guifg={{red}} guibg=NONE gui=bold
highlight Todo         guifg={{bg}} guibg={{yellow}} gui=bold
highlight Directory    guifg={{accent}} gui=bold

" Statuszeilen-Farbgruppen
highlight StatusLine          guifg={{text}} guibg={{bg_alt}} gui=NONE
highlight StatusLineNC        guifg={{muted}} guibg={{bg_alt}} gui=NONE
highlight StlModeNormal       guifg={{on_accent}} guibg={{accent}} gui=bold
highlight StlModeInsert       guifg={{bg}} guibg={{green}} gui=bold
highlight StlModeVisual       guifg={{bg}} guibg={{purple}} gui=bold
highlight StlModeReplace      guifg={{bg}} guibg={{red}} gui=bold
highlight StlModeCommand      guifg={{bg}} guibg={{orange}} gui=bold
highlight StlSectionMid       guifg={{text}} guibg={{bg_alt}} gui=NONE
highlight StlSectionFile      guifg={{text}} guibg={{surface_alt}} gui=NONE
highlight StlSectionModified  guifg={{yellow}} guibg={{surface_alt}} gui=bold
highlight StlSectionNumMode   guifg={{cyan}} guibg={{surface_alt}} gui=bold
highlight StlSectionPos       guifg={{on_accent}} guibg={{accent}} gui=bold
